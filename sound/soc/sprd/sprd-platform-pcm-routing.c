	.dapm_widgets		= sprd_pcm_routing_widgets,
	.num_dapm_widgets	= ARRAY_SIZE(sprd_pcm_routing_widgets),
	.dapm_routes		= sprd_pcm_routing_intercon,
	.num_dapm_routes	= ARRAY_SIZE(sprd_pcm_routing_intercon),
};

/*
 * Narrow DAPM event filter.  In the vendor binary this helper accepts only
 * SND_SOC_DAPM_PRE_PMU / PRE_PMD / POST_PMU / POST_PMD (bit mask 0x8b of
 * (event - 1)) and returns -EINVAL otherwise; the widgets table itself has
 * a NULL event pointer, so it is kept here only for completeness.
 */
static int __maybe_unused be_switch_evt(struct snd_soc_dapm_widget *w,
					struct snd_kcontrol *kcontrol, int event)
{
	switch (event) {
	case SND_SOC_DAPM_PRE_PMU:
	case SND_SOC_DAPM_PRE_PMD:
	case SND_SOC_DAPM_POST_PMU:
	case SND_SOC_DAPM_POST_PMD:
		return 0;
	default:
		return -EINVAL;
	}
}

static int sprd_platform_routing_probe(struct platform_device *pdev)
{
	return snd_soc_register_component(&pdev->dev,
					  &sprd_soc_routing_platform, NULL, 0);
}

static int sprd_platform_routing_remove(struct platform_device *pdev)
{
	snd_soc_unregister_component(&pdev->dev);

	return 0;
}

