	.probe	= sprd_platform_routing_probe,
	.remove	= sprd_platform_routing_remove,
	.driver	= {
		.name		= "sprd-pcm-routing",
		.of_match_table	= sprd_pcm_routing_of_match,
	},
};
module_platform_driver(sprd_pcm_routing_driver);

